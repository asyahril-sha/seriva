# =====================================================
# SERIVA – Environment Example (DeepSeek + Webhook / Railway)
# Salin file ini menjadi `.env` (untuk lokal) atau isi langsung di Railway
# lalu ganti nilai-nilai placeholder di bawah ini.
# =====================================================

# -------------------------------------
# Telegram Bot
# -------------------------------------

# Token bot dari BotFather (format: 1234567890:ABC...)
TELEGRAM_BOT_TOKEN=1234567890:REPLACE_WITH_YOUR_BOT_TOKEN

# Telegram user ID admin yang boleh pakai bot (angka, bukan @username)
# Contoh: 306852630
SERIVA_ADMIN_ID=REPLACE_WITH_YOUR_TELEGRAM_USER_ID

# -------------------------------------
# LLM / DeepSeek (Gaya A)
# -------------------------------------

# API key DeepSeek milikmu.
# Dalam kode SERIVA, jika LLM_API_KEY kosong tapi DEEPSEEK_API_KEY ada,
# maka DEEPSEEK_API_KEY otomatis dipakai sebagai LLM_API_KEY.
DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_API_KEY

# Endpoint chat LLM (OpenAI-compatible).
# Contoh untuk DeepSeek (cek dokumentasi resmimu untuk memastikan):
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions

# Nama model DeepSeek yang kamu pakai.
# Contoh: deepseek-chat, deepseek-coder, dsb.
LLM_MODEL=deepseek-chat

# (Optional) Kalau kamu mau isi langsung LLM_API_KEY juga boleh,
# tapi untuk gaya A cukup isi DEEPSEEK_API_KEY saja.
# LLM_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_API_KEY

# -------------------------------------
# Webhook (Mode Railway)
# -------------------------------------

# URL publik Railway untuk webhook, HARUS mengarah ke path /webhook
# Contoh: https://seriva-production.up.railway.app/webhook
WEBHOOK_URL=https://your-railway-domain.up.railway.app/webhook

# PORT akan di-set otomatis oleh Railway, jadi biasanya tidak perlu diisi.
# Untuk testing lokal (jika perlu):
# PORT=8080
